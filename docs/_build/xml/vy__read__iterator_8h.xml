        <name>vy_read_iterator_cache_add</name>
        <param>
          <type>struct <ref refid="structvy__read__iterator" kindref="compound">vy_read_iterator</ref> *</type>
          <declname>itr</declname>
        </param>
        <param>
          <type>struct <ref refid="structvy__entry" kindref="compound">vy_entry</ref></type>
