      <memberdef kind="define" id="title_8c_1ad095e189af068193b74eee18895da212" prot="public" static="no">
        <name>DEFINE_STRING_ACCESSORS</name>
        <param><defname>name</defname></param>
        <initializer>const char *title_get_ ## name() { return name; } \
void title_set_ ## name(const char *str) \
{ \
	if (str == NULL || str[0] == &apos;\0&apos;) { \
		free(name); name = NULL; \
		return; \
	} \
	size_t len = strlen(str); \
	char *p = realloc(name, len + 1); \
	if (p) { \
		name = memcpy(p, str, len + 1); \
	} \
}</initializer>
