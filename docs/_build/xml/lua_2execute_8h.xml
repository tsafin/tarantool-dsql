</parameternamelist>
<parameterdescription>
<para>0 Number of decoded parameters. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>-1</parametername>
</parameternamelist>
<parameterdescription>
<para>Client or memory error. </para></parameterdescription>
</parameteritem>
</parameterlist>
</para>        </detaileddescription>
