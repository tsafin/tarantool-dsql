        <param>
          <type>struct <ref refid="structtuple" kindref="compound">tuple</ref> *</type>
          <declname>new_stmt</declname>
        </param>
        <param>
          <type>struct <ref refid="structtuple" kindref="compound">tuple</ref> *</type>
