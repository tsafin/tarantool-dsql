      <memberdef kind="variable" id="structtxn__limbo_1acb4c5515bf3cadc680ebe5f63a80608d" prot="public" static="no" mutable="no">
        <type>int64_t</type>
        <definition>int64_t txn_limbo::confirmed_lsn</definition>
        <argsstring></argsstring>
        <name>confirmed_lsn</name>
        <briefdescription>
<para>Maximal LSN gathered quorum and either already confirmed in WAL, or whose confirmation is in progress right now. </para>        </briefdescription>
        <detaileddescription>
<para>Any attempt to confirm something smaller than this value can be safely ignored. Moreover, any attempt to rollback something starting from &lt;= this LSN is illegal. </para>        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
