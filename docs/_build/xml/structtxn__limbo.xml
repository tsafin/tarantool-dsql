        <definition>int64_t txn_limbo::rollback_count</definition>
        <argsstring></argsstring>
        <name>rollback_count</name>
        <briefdescription>
<para>Total number of performed rollbacks. </para>        </briefdescription>
        <detaileddescription>
<para>It used as a guard to do some actions assuming all limbo transactions will be confirmed, and to check that there were no rollbacks in the end. </para>        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="/home/tsafin/tarantool/src/box/txn_limbo.h" line="142" column="1" bodyfile="/home/tsafin/tarantool/src/box/txn_limbo.h" bodystart="142" bodyend="-1"/>
