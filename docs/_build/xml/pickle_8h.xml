        <name>pack_u</name>
        <param><defname>bits</defname></param>
        <initializer>static inline char *						\
pack_u##bits(char *buf, uint##bits##_t val)			\
{								\
	*(uint##bits##_t *) buf = val;				\
	return buf + sizeof(uint##bits##_t);			\
}</initializer>
