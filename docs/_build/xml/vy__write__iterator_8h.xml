</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>old_stmt</parametername>
</parameternamelist>
<parameterdescription>
<para>Overwritten tuple. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>new_stmt</parametername>
</parameternamelist>
<parameterdescription>
<para>Statement that overwrote .</para></parameterdescription>
</parameteritem>
</parameterlist>
<parameterlist kind="retval"><parameteritem>
<parameternamelist>
<parametername>0</parametername>
</parameternamelist>
<parameterdescription>
<para>Success. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>-1</parametername>
</parameternamelist>
<parameterdescription>
<para>Error.</para></parameterdescription>
</parameteritem>
</parameterlist>
