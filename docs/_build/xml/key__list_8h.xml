        <type>int</type>
        <definition>int key_list_iterator_create</definition>
        <argsstring>(struct key_list_iterator *it, struct tuple *tuple, struct index_def *index_def, bool validate, key_list_allocator_t key_allocator)</argsstring>
        <name>key_list_iterator_create</name>
        <param>
          <type>struct <ref refid="structkey__list__iterator" kindref="compound">key_list_iterator</ref> *</type>
          <declname>it</declname>
        </param>
        <param>
