digraph point_lookup_cost {
    graph [
        bgcolor="white",
        rankdir=TB,
        pad=0.25,
        nodesep=0.45,
        ranksep=0.6,
        fontname="Helvetica",
        labelloc="t"
    ];
    node [
        shape=plain,
        fontname="Helvetica"
    ];
    edge [
        color="#555555",
        penwidth=1.4,
        arrowsize=0.8
    ];

    prepared [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" COLOR="#4b6a88">
            <TR><TD BGCOLOR="#dbeeff" COLSPAN="2"><B>Prepared once, execute many times (100 000 iters)</B></TD></TR>
            <TR><TD BGCOLOR="#eef6fb" ALIGN="LEFT">Interpreter prepare</TD><TD BGCOLOR="#eef6fb"><B>8.000 µs</B></TD></TR>
            <TR><TD BGCOLOR="#ffd6cf" ALIGN="LEFT">LLVM MCJIT prepare</TD><TD BGCOLOR="#ffd6cf"><B>9 224 µs</B></TD></TR>
            <TR><TD BGCOLOR="#eef6fb" ALIGN="LEFT">CnP prepare</TD><TD BGCOLOR="#eef6fb"><B>8.000 µs</B></TD></TR>
            <TR><TD BGCOLOR="#e5f7ea" ALIGN="LEFT">Interpreter execute</TD><TD BGCOLOR="#e5f7ea"><B>2.270 µs/op</B></TD></TR>
            <TR><TD BGCOLOR="#e5f7ea" ALIGN="LEFT">LLVM MCJIT execute</TD><TD BGCOLOR="#e5f7ea"><B>2.250 µs/op</B></TD></TR>
            <TR><TD BGCOLOR="#e5f7ea" ALIGN="LEFT">CnP execute</TD><TD BGCOLOR="#e5f7ea"><B>2.290 µs/op</B></TD></TR>
            <TR><TD BGCOLOR="#fff4d9" ALIGN="LEFT">LLVM MCJIT break-even</TD><TD BGCOLOR="#fff4d9"><B>~460 000 execs</B></TD></TR>
        </TABLE>
    >];

    cached [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" COLOR="#2a6e2a">
            <TR><TD BGCOLOR="#d4ecd4" COLSPAN="2"><B>Automatic execute — warm cache (100 000 iters)</B></TD></TR>
            <TR><TD BGCOLOR="#e8f4e8" ALIGN="LEFT">Interpreter total</TD><TD BGCOLOR="#e8f4e8"><B>2.250 µs/op</B></TD></TR>
            <TR><TD BGCOLOR="#e8f4e8" ALIGN="LEFT">LLVM MCJIT total</TD><TD BGCOLOR="#e8f4e8"><B>2.230 µs/op</B></TD></TR>
            <TR><TD BGCOLOR="#e8f4e8" ALIGN="LEFT">CnP total</TD><TD BGCOLOR="#e8f4e8"><B>2.270 µs/op</B></TD></TR>
            <TR><TD BGCOLOR="#d4ecd4" ALIGN="LEFT">Compile on first call only</TD><TD BGCOLOR="#d4ecd4"><B>once per SQL string</B></TD></TR>
        </TABLE>
    >];

    summary [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" COLOR="#666666">
            <TR><TD BGCOLOR="#f2f2f2"><B>Interpretation</B></TD></TR>
            <TR><TD BGCOLOR="#fafafa" ALIGN="LEFT">Automatic execute now equals prepared execute speed.</TD></TR>
            <TR><TD BGCOLOR="#fafafa" ALIGN="LEFT">LLVM MCJIT break-even is ~460k execs for point_lookup.</TD></TR>
            <TR><TD BGCOLOR="#fafafa" ALIGN="LEFT">CnP has no break-even penalty: prepare cost = interpreter.</TD></TR>
        </TABLE>
    >];

    prepared -> summary;
    cached -> summary;
}
