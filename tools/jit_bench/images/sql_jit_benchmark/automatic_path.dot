digraph automatic_path {
    graph [
        bgcolor="white",
        rankdir=LR,
        pad=0.2,
        nodesep=0.45,
        ranksep=0.7,
        fontname="Helvetica"
    ];
    node [
        shape=box,
        style="rounded,filled",
        fontname="Helvetica",
        fontsize=14,
        color="#4a2f2f",
        penwidth=1.4,
        fillcolor="#fff3f1",
        margin="0.16,0.08"
    ];
    edge [
        color="#8c5550",
        penwidth=1.6,
        arrowsize=0.8
    ];

    sql    [label="SQL text", fillcolor="#f8f8f8", color="#666666"];
    exec   [label="box.execute(sql, args)", fillcolor="#ffe4df"];
    lookup [label="auto_stmt_cache\nlookup (256-slot)", fillcolor="#e8f4e8", color="#2a6e2a"];
    miss   [label="MISS:\nPrepare + JIT compile\n(once per distinct SQL)", fillcolor="#ffd6cf"];
    store  [label="Store in cache", fillcolor="#d4ecd4", color="#2a6e2a"];
    hit    [label="HIT:\nReset + rebind\n(no recompile)", fillcolor="#d4ecd4", color="#2a6e2a"];
    run    [label="Execute\n(reuse cached stmt)", fillcolor="#ffe8c8", color="#8d6937"];

    sql -> exec -> lookup;
    lookup -> miss [label="first call"];
    miss -> store -> run;
    lookup -> hit [label="subsequent calls"];
    hit -> run;
}
