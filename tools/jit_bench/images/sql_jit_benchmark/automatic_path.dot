digraph automatic_path {
    graph [
        bgcolor="white",
        rankdir=LR,
        pad=0.2,
        nodesep=0.45,
        ranksep=0.7,
        fontname="Helvetica"
    ];
    node [
        shape=box,
        style="rounded,filled",
        fontname="Helvetica",
        fontsize=14,
        color="#4a2f2f",
        penwidth=1.4,
        fillcolor="#fff3f1",
        margin="0.16,0.08"
    ];
    edge [
        color="#8c5550",
        penwidth=1.6,
        arrowsize=0.8
    ];

    sql   [label="SQL text", fillcolor="#f8f8f8", color="#666666"];
    exec  [label="box.execute(sql, args)", fillcolor="#ffe4df"];
    prep  [label="Prepare every call", fillcolor="#ffd6cf"];
    jit   [label="JIT compile every call\nif enabled", fillcolor="#ffc7bd"];
    once  [label="Execute once", fillcolor="#ffe8c8", color="#8d6937"];
    drop  [label="Statement destroyed", fillcolor="#f1f1f1", color="#777777"];

    sql -> exec -> prep -> jit -> once -> drop;
}
