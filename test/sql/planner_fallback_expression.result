test_run = require('test_run').new()
---
...
engine = test_run:get_cfg('engine')
---
...
_ = box.space._session_settings:update('sql_default_engine', {{'=', 2, engine}})
---
...
box.execute([[CREATE TABLE fallback_expression_t (id INTEGER PRIMARY KEY, v STRING)]])
---
- row_count: 1
...
before = box.stat.sql()
---
...
cast_summary, err = box.execute([[EXPLAIN (planner = 'summary') SELECT CAST(v AS INTEGER) FROM fallback_expression_t]])
---
...
assert(err == nil)
---
- true
...
assert(cast_summary.rows[1][3] == 'fallback')
---
- true
...
assert(cast_summary.rows[2][3] == 'UNSUPPORTED_EXPRESSION')
---
- true
...
like_summary, err = box.execute([[EXPLAIN (planner = 'summary') SELECT v FROM fallback_expression_t WHERE v LIKE '%x%']])
---
...
assert(err == nil)
---
- true
...
assert(like_summary.rows[2][3] == 'UNSUPPORTED_FUNCTION')
---
- true
...
limit_summary, err = box.execute([[EXPLAIN (planner = 'summary') SELECT v FROM fallback_expression_t LIMIT 1 + 1]])
---
...
assert(err == nil)
---
- true
...
assert(limit_summary.rows[2][3] == 'UNSUPPORTED_EXPRESSION')
---
- true
...
negative_limit_summary, err = box.execute([[EXPLAIN (planner = 'summary') SELECT v FROM fallback_expression_t LIMIT -1]])
---
...
assert(err == nil)
---
- true
...
assert(negative_limit_summary.rows[2][3] == 'UNSUPPORTED_EXPRESSION')
---
- true
...
bound_limit_summary, err = box.execute([[EXPLAIN (planner = 'summary') SELECT v FROM fallback_expression_t LIMIT ?]], {1})
---
...
assert(err == nil)
---
- true
...
assert(bound_limit_summary.rows[2][3] == 'UNSUPPORTED_EXPRESSION')
---
- true
...
bound_offset_summary, err = box.execute([[EXPLAIN (planner = 'summary') SELECT v FROM fallback_expression_t LIMIT 1 OFFSET ?]], {0})
---
...
assert(err == nil)
---
- true
...
assert(bound_offset_summary.rows[2][3] == 'UNSUPPORTED_EXPRESSION')
---
- true
...
after = box.stat.sql()
---
...
assert(after.sql_planner_fallback_total == before.sql_planner_fallback_total + 6)
---
- true
...
assert(after.sql_planner_fallback_UNSUPPORTED_EXPRESSION_total == before.sql_planner_fallback_UNSUPPORTED_EXPRESSION_total + 5)
---
- true
...
assert(after.sql_planner_fallback_UNSUPPORTED_FUNCTION_total == before.sql_planner_fallback_UNSUPPORTED_FUNCTION_total + 1)
---
- true
...
test_run = require('test_run').new()
---
...
