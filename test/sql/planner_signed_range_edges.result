test_run = require('test_run').new()
---
...
before, after, summary, err, result, disabled_cross_summary, disabled_cross, enabled_cross_summary, enabled_cross, full_domain_sql, full_domain_disabled, full_domain_enabled, min_inclusive_sql, min_exclusive_sql, max_inclusive_sql, max_exclusive_sql, min_inclusive_disabled, min_exclusive_disabled, max_inclusive_disabled, max_exclusive_disabled, min_inclusive_enabled, min_exclusive_enabled, max_inclusive_enabled, max_exclusive_enabled = nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil
---
...
engine = test_run:get_cfg('engine')
---
...
_ = box.space._session_settings:update('sql_default_engine', {{'=', 2, engine}})
---
...
box.execute([[SET SESSION "sql_seq_scan" = true]])
---
- row_count: 1
...
box.execute([[CREATE TABLE planner_signed_range_edges_t (id INTEGER PRIMARY KEY, v INTEGER)]])
---
- row_count: 1
...
box.execute([[INSERT INTO planner_signed_range_edges_t VALUES (-9223372036854775808, 10), (-1, 20), (0, 30), (1, 40), (9223372036854775807, 50)]])
---
- row_count: 5
...
function assert_fallback_delta(before, after, reason, label) local expected = reason == nil and 0 or 2; assert(after.sql_planner_fallback_total == before.sql_planner_fallback_total + expected, label .. ': fallback total delta mismatch'); for key, value in pairs(before) do if key:match('^sql_planner_fallback_.*_total$') and key ~= 'sql_planner_fallback_total' then local delta = reason ~= nil and key == 'sql_planner_fallback_' .. reason .. '_total' and expected or 0; assert(after[key] == value + delta, label .. ': ' .. key .. ' delta mismatch') end end end
---
...
function capture_signed_boundary(sql, route, reason, label) before = box.stat.sql(); summary, err = box.execute([[EXPLAIN (planner = 'summary') ]] .. sql); assert(err == nil and summary.rows[1][3] == route, label .. ': unexpected route ' .. tostring(summary and summary.rows[1][3])); assert((summary.rows[2] and summary.rows[2][3] or nil) == reason, label .. ': fallback reason mismatch'); result, err = box.execute(sql); assert(err == nil, label .. ': execution failed: ' .. tostring(err)); after = box.stat.sql(); assert_fallback_delta(before, after, reason, label); return result.rows end
---
...
box.execute([[SET SESSION "sql_new_planner_single_table" = false]])
---
- row_count: 1
...
disabled_cross_summary, err = box.execute([[EXPLAIN (planner = 'summary') SELECT id FROM planner_signed_range_edges_t WHERE id >= -1 AND id <= 1]])
---
...
assert(err == nil and disabled_cross_summary.rows[1][3] == 'current_where_c')
---
- true
...
disabled_cross = box.execute([[SELECT id FROM planner_signed_range_edges_t WHERE id >= -1 AND id <= 1]]).rows
---
...
box.execute([[SET SESSION "sql_new_planner_single_table" = true]])
---
- row_count: 1
...
enabled_cross_summary, err = box.execute([[EXPLAIN (planner = 'summary') SELECT id FROM planner_signed_range_edges_t WHERE id >= -1 AND id <= 1]])
---
...
assert(err == nil and enabled_cross_summary.rows[1][3] == 'new_planner')
---
- true
...
enabled_cross = box.execute([[SELECT id FROM planner_signed_range_edges_t WHERE id >= -1 AND id <= 1]]).rows
---
...
assert(#enabled_cross == 3 and #disabled_cross == 3)
---
- true
...
assert(enabled_cross[1][1] == -1 and enabled_cross[2][1] == 0 and enabled_cross[3][1] == 1)
---
- true
...
assert(enabled_cross[1][1] == disabled_cross[1][1] and enabled_cross[2][1] == disabled_cross[2][1] and enabled_cross[3][1] == disabled_cross[3][1])
---
- true
...
box.execute([[SET SESSION "sql_new_planner_single_table" = false]])
---
- row_count: 1
...
full_domain_sql = [[SELECT id FROM planner_signed_range_edges_t WHERE id >= -9223372036854775808 AND id <= 9223372036854775807]]
---
...
full_domain_disabled = capture_signed_boundary(full_domain_sql, 'current_where_c', nil, 'off full domain')
---
...
box.execute([[SET SESSION "sql_new_planner_single_table" = true]])
---
- row_count: 1
...
full_domain_enabled = capture_signed_boundary(full_domain_sql, 'new_planner', nil, 'on full domain')
---
...
assert(#full_domain_disabled == 5, 'legacy full signed domain row count: '..#full_domain_disabled)
---
- true
- 'legacy full signed domain row count: 5'
...
assert(#full_domain_enabled == 5, 'new-planner full signed domain row count: '..#full_domain_enabled)
---
- true
- 'new-planner full signed domain row count: 5'
...
box.execute([[SET SESSION "sql_new_planner_single_table" = false]])
