test_run = require('test_run').new()
---
...
engine = test_run:get_cfg('engine')
---
...
_ = box.space._session_settings:update('sql_default_engine', {{'=', 2, engine}})
---
...
box.execute([[CREATE TABLE fallback_function_t (id INTEGER PRIMARY KEY, v INTEGER)]])
---
- row_count: 1
...
before = box.stat.sql()
---
...
summary, err = box.execute([[EXPLAIN (planner = 'summary') SELECT abs(v) FROM fallback_function_t]])
---
...
assert(err == nil)
---
- true
...
assert(summary.rows[1][3] == 'fallback')
---
- true
...
assert(summary.rows[2][3] == 'UNSUPPORTED_FUNCTION')
---
- true
...
predicate, err = box.execute([[EXPLAIN (planner = 'summary') SELECT v FROM fallback_function_t WHERE abs(v) > 1]])
---
...
assert(err == nil)
---
- true
...
assert(predicate.rows[2][3] == 'UNSUPPORTED_FUNCTION')
---
- true
...
ordering, err = box.execute([[EXPLAIN (planner = 'summary') SELECT v FROM fallback_function_t ORDER BY abs(v)]])
---
...
assert(err == nil)
---
- true
...
assert(ordering.rows[2][3] == 'UNSUPPORTED_FUNCTION')
---
- true
...
aggregate, err = box.execute([[EXPLAIN (planner = 'summary') SELECT sum(abs(v)) FROM fallback_function_t]])
---
...
assert(err == nil)
---
- true
...
assert(aggregate.rows[2][3] == 'UNSUPPORTED_AGGREGATE')
---
- error: assertion failed!
...
after = box.stat.sql()
---
...
assert(after.sql_planner_fallback_total == before.sql_planner_fallback_total + 4)
---
- true
...
assert(after.sql_planner_fallback_UNSUPPORTED_FUNCTION_total == before.sql_planner_fallback_UNSUPPORTED_FUNCTION_total + 3)
---
- error: '[string "return assert(after.sql_planner_fallback_UNSU..."]:1: attempt to
    perform arithmetic on field ''sql_planner_fallback_UNSUPPORTED_FUNCTION_total''
    (a nil value)'
...
assert(after.sql_planner_fallback_UNSUPPORTED_AGGREGATE_total == before.sql_planner_fallback_UNSUPPORTED_AGGREGATE_total + 1)
---
- error: assertion failed!
...
test_run = require('test_run').new()
---
...
