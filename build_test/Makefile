	$(MAKE) -f CMakeFiles/Makefile2 tt_sort.test
.PHONY : tt_sort.test

# fast build rule for target.
tt_sort.test/fast:
	$(MAKE) -f test/unit/CMakeFiles/tt_sort.test.dir/build.make test/unit/CMakeFiles/tt_sort.test.dir/build
.PHONY : tt_sort.test/fast

